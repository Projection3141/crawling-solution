{
  "name": "mall-collector-desktop",
  "productName": "Mall Collector",
  "version": "1.3.4",
  "description": "특정 사이트의 상품·재고를 수집하는 데스크톱 앱",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "translate": "node translate/translate.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "check": "node scripts/check-syntax.js",
    "postinstall": "node scripts/install-playwright.js",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\""
  },
  "keywords": [
    "electron",
    "playwright",
    "crawler",
    "cheerio"
  ],
